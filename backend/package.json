{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend serverless functions for Cloud Exam Platform",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "deploy": "./scripts/deploy.sh",
    "deploy:staging": "./scripts/deploy.sh staging",
    "deploy:production": "./scripts/deploy.sh production",
    "deploy:database": "./scripts/deploy-database.sh",
    "deploy:database:staging": "./scripts/deploy-database.sh staging",
    "deploy:database:production": "./scripts/deploy-database.sh production",
    "local": "./scripts/local.sh",
    "sam:build": "sam build",
    "sam:validate": "sam validate --lint",
    "validate:translations": "tsx scripts/validate-translations/index.ts",
    "smoke:spanish": "tsx scripts/smoke-spanish.ts"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.400.0",
    "@aws-sdk/client-dynamodb": "^3.981.0",
    "@aws-sdk/client-s3": "^3.981.0",
    "@aws-sdk/client-translate": "^3.1045.0",
    "@aws-sdk/lib-dynamodb": "^3.981.0",
    "@aws-sdk/s3-request-presigner": "^3.981.0",
    "@aws-sdk/util-dynamodb": "^3.981.0",
    "@types/busboy": "^1.5.4",
    "aws-sdk": "^2.1400.0",
    "bcryptjs": "^2.4.3",
    "busboy": "^1.6.0",
    "jsonwebtoken": "^9.0.0",
    "node-fetch": "^2.6.11",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.119",
    "@types/bcryptjs": "^2.4.2",
    "@types/jest": "^29.5.0",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/node": "^20.0.0",
    "@types/uuid": "^9.0.0",
    "fast-check": "^3.10.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "tsx": "^3.12.0",
    "typescript": "^5.1.0"
  }
}
