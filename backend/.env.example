# AWS Configuration
AWS_REGION=us-east-1
DYNAMODB_TABLE_PREFIX=cloud-exam-platform

# Authentication
JWT_SECRET=your-secret-key-here
JWT_EXPIRATION=24h

# S3 Configuration
S3_BUCKET_NAME=cloud-exam-platform-images
S3_REGION=us-east-1

# Database Tables
USERS_TABLE=cloud-exam-platform-users
STUDENTS_TABLE=cloud-exam-platform-students
COURSES_TABLE=cloud-exam-platform-courses
QUESTIONS_TABLE=cloud-exam-platform-questions
ALTERNATIVES_TABLE=cloud-exam-platform-alternatives
ENROLLMENTS_TABLE=cloud-exam-platform-enrollments
EXAM_SESSIONS_TABLE=cloud-exam-platform-exam-sessions
ANSWERS_TABLE=cloud-exam-platform-answers
EXAM_RESULTS_TABLE=cloud-exam-platform-exam-results
SYSTEM_CONFIG_TABLE=cloud-exam-platform-system-config

# Environment
NODE_ENV=development
